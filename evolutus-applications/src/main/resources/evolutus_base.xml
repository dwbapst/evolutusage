<?xml version="1.0" encoding="UTF-8" ?>
<configuration xmlns="http://age.iisg.agh.edu.pl/schema/age"
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://age.iisg.agh.edu.pl/schema/age http://age.iisg.agh.edu.pl/schema/age/age.xsd">


  <!-- jAge components -->

  <component class="org.jage.address.node.DefaultNodeAddressSupplier"/>
  <component class="org.jage.communication.LoopbackCommunicationService"/>

  <component name="configurationService" class="org.jage.lifecycle.DefaultConfigurationService"/>

  <component name="defaultAgentAddressSupplier" class="org.jage.address.agent.DefaultAgentAddressSupplier"/>
  <component name="comparator" class="org.jage.action.ordering.DefaultActionComparator" isSingleton="false"/>

  <component name="aggregateActionService" class="org.jage.agent.AggregateActionService" isSingleton="false"/>
  <component name="aggregateQueryService" class="org.jage.agent.AggregateQueryService" isSingleton="false"/>
  <component name="aggregateMessagingService" class="org.jage.agent.AggregateMessagingService" isSingleton="false"/>


  <!-- eVolutus components -->

  <component name="statisticsService" class="pl.edu.agh.evolutus.service.StatisticsService"/>
  <component name="visualizationService" class="pl.edu.agh.evolutus.service.VisualizationService"/>
  <component name="connectionProvider" class="pl.edu.agh.evolutus.service.ConnectionProvider"/>
  <component name="templateRenderer" class="pl.edu.agh.evolutus.service.TemplateRenderer"/>
  <component name="psiFileGenerator" class="pl.edu.agh.evolutus.service.PsiFileGenerator"/>
  <component name="configFactory" class="pl.edu.agh.evolutus.config.ConfigFactory"/>

  <component name="onePointCrossingOverOperator" class="pl.edu.agh.evolutus.genotype.operator.OnePointCrossingOverOperator"/>
  <component name="twoPointCrossingOverOperator" class="pl.edu.agh.evolutus.genotype.operator.TwoPointCrossingOverOperator"/>
  <component name="uniformCrossingOverOperator" class="pl.edu.agh.evolutus.genotype.operator.UniformCrossingOverOperator"/>

  <block name="foram">
    <agent class="pl.edu.agh.evolutus.foram.Foram">
      <component class="org.jage.address.agent.DefaultAgentAddressSupplier">
        <constructor-arg name="nameTemplate" value="Foram#*"/>
      </component>
    </agent>
  </block>

  <block name="oceanFragment">
    <agent class="pl.edu.agh.evolutus.environment.OceanFragment">
      <component class="org.jage.address.agent.DefaultAgentAddressSupplier">
        <constructor-arg name="nameTemplate" value="OceanFragment#*"/>
      </component>
    </agent>
  </block>

  <block name="oceanFragmentContainers">
    <list name="oceanFragmentContainers">
      <multiple count="1">
        <agent name="oceanFragmentContainer" class="pl.edu.agh.evolutus.environment.OceanFragmentContainer">
          <component class="org.jage.address.agent.DefaultAgentAddressSupplier">
            <constructor-arg name="nameTemplate" value="OceanFragmentContainer#*"/>
          </component>
        </agent>
      </multiple>
    </list>
  </block>

  <component name="workplaceManager" class="org.jage.workplace.manager.DefaultWorkplaceManager">

    <property name="workplaces" ref="oceanFragmentContainers"/>

    <block name="stopCondition">
      <component name="stopCondition" class="pl.edu.agh.evolutus.simulation.StopCondition"/>
    </block>
  </component>
</configuration>
