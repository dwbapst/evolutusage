<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<artifactId>evolutus-applications</artifactId>

	<name>Evolutus applications</name>
	<description>Evolutus applications module</description>

	<parent>
		<groupId>pl.edu.agh</groupId>
		<artifactId>evolutus</artifactId>
		<version>1.0-SNAPSHOT</version>
	</parent>

	<properties>
		<age.node.conf>classpath:evolutus_base.xml</age.node.conf>
	</properties>

	<dependencies>
		<!-- AgE Modules -->
		<dependency>
			<groupId>org.jage.platform</groupId>
			<artifactId>cli-bootstrapper</artifactId>
			<version>${jage.version}</version>
		</dependency>

		<dependency>
			<groupId>org.jage.services</groupId>
			<artifactId>communication-hazelcast</artifactId>
			<version>${jage.version}</version>
		</dependency>

		<!-- Evolutus Modules -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>evolutus-solutions</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>evolutus-cmd</artifactId>
			<version>${project.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>1.1</version>

				<configuration>
					<mainClass>org.jage.platform.cli.CliNodeBootstrapper</mainClass>
					<arguments>
						<argument>-Dage.node.conf=${age.node.conf}</argument>
					</arguments>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
